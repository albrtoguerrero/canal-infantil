# Copia este archivo a .env (o crea secretos en GitHub) y rellena las claves.
# TODAS las claves son de servicios con capa gratuita.

# Gemini: https://aistudio.google.com -> Get API key
GEMINI_API_KEY=

# Pixabay: https://pixabay.com/api/docs/ (crea cuenta gratis, la clave sale en la doc)
PIXABAY_API_KEY=

# Google Cloud Console -> crear proyecto -> habilitar "YouTube Data API v3"
# -> credenciales OAuth 2.0 tipo "Aplicación web" con redirect http://localhost:8080
YT_CLIENT_ID=
YT_CLIENT_SECRET=
# Se obtiene ejecutando: npm run autorizar
YT_REFRESH_TOKEN=

# Pon "true" solo cuando quieras que suba de verdad a YouTube
SUBIR=false
